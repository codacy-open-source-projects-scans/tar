AT_SETUP([--exclude-ignore-recursive with transforms])
AT_KEYWORDS([exclude exclude-ignore-recursive extract exclude22])
AT_TAR_CHECK([
AT_SORT_PREREQ
mkdir dir dir/subdir
touch dir/file1 dir/file.ext dir/subdir/file2.foo dir/subdir/file3 \
      dir/subdir/file4.txt dir/subdir/file5.ext
cat > dir/ignorefile <<\EOT
ignorefile
*.ext
EOT
cat > dir/subdir/ignorefile <<\EOT
file4.txt
*.foo
EOT
tar -cf archive.tar --exclude-ignore-recursive=ignorefile \
    --transform='s/^dir/DIRECTORY/' dir
rm -rf dir
tar xfv archive.tar | sort
],
[0],
[DIRECTORY/
DIRECTORY/file1
DIRECTORY/subdir/
DIRECTORY/subdir/file3
])

AT_CLEANUP
